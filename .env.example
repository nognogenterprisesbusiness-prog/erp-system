# Copy these names into .env.local for local development or set them in the
# deployment environment. Each environment points to its own Supabase project.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
SUPABASE_SECRET_KEY=your-server-only-secret-key
APP_SITE_URL=http://localhost:3000

# Never expose SUPABASE_SECRET_KEY through a NEXT_PUBLIC_ variable.
