# Set one explicitly. Staging must use credentials for a separate Supabase project.
APP_MODE=staging
NEXT_PUBLIC_APP_MODE=staging
ENABLE_LOCAL_DEMO=false
# Staging is a separate project. Never copy production credentials into these values.
NEXT_PUBLIC_STAGING_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_STAGING_SUPABASE_PUBLISHABLE_KEY=replace-with-staging-publishable-key
STAGING_SUPABASE_SECRET_KEY=replace-with-staging-server-only-secret
APP_SITE_URL=http://127.0.0.1:3000
# Production deployments instead use NEXT_PUBLIC_SUPABASE_URL and
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY with APP_MODE=production.
# Set SUPABASE_SECRET_KEY and APP_SITE_URL separately for production.
# For a standalone local demo, set APP_MODE and NEXT_PUBLIC_APP_MODE to
# local-demo and ENABLE_LOCAL_DEMO=true. No Supabase credentials are used.
# Privileged/service-role/database credentials must never use NEXT_PUBLIC_ names.
