# Copy these names into .env.local for local development or set them in the
# deployment environment. Each environment points to its own Supabase project.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
SUPABASE_SECRET_KEY=your-server-only-secret-key
APP_SITE_URL=http://localhost:3000

# Optional released Android/iOS download or store URLs. HTTPS only; no secrets.
# Set these to a published replacement before requiring any build or protocol.
MOBILE_ANDROID_UPDATE_URL=
MOBILE_IOS_UPDATE_URL=
MOBILE_ANDROID_MIN_BUILD=
MOBILE_IOS_MIN_BUILD=
# Set to 2 only after protocol-2 replacements are available on every active platform.
MOBILE_MIN_PROTOCOL=

# Never expose SUPABASE_SECRET_KEY through a NEXT_PUBLIC_ variable.
