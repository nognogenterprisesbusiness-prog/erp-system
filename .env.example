# Set one explicitly. Staging must use credentials for a separate Supabase project.
APP_MODE=staging
NEXT_PUBLIC_APP_MODE=staging
# Staging is a separate project. Never copy production credentials into these values.
NEXT_PUBLIC_STAGING_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_STAGING_SUPABASE_PUBLISHABLE_KEY=replace-with-staging-publishable-key
STAGING_SUPABASE_SECRET_KEY=replace-with-staging-server-only-secret
APP_SITE_URL=http://127.0.0.1:3000
# Production deployments instead use NEXT_PUBLIC_SUPABASE_URL and
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY with APP_MODE=production.
# Set SUPABASE_SECRET_KEY and APP_SITE_URL separately for production.
# Optional, staging-only account switcher. First sign in normally with one of
# the isolated test accounts; then switch among them from the profile menu.
# Never enable on a production deployment or use real employee credentials.
STAGING_PREVIEW_ENABLED=false
# Set only in the server environment when enabled. Every listed account must
# already exist in the isolated staging Supabase Auth project with its own role.
# The staging seed creates four @nognog.local users with random, unusable
# passwords. Set unique strong passwords for all four seed emails in this
# server-only JSON value, then run npm run staging:provision-preview.
# STAGING_PREVIEW_EXPECTED_URL must exactly equal NEXT_PUBLIC_STAGING_SUPABASE_URL
# when running that provisioning command.
# STAGING_PREVIEW_EXPECTED_URL=https://your-staging-project.supabase.co
# STAGING_PREVIEW_ACCOUNTS='[{"label":"Admin","email":"admin@nognog.local","password":"unique-long-password"},{"label":"Engineer","email":"engineer@nognog.local","password":"another-long-password"},{"label":"Foreman","email":"foreman@nognog.local","password":"third-long-password"},{"label":"Warehouse staff","email":"warehouse@nognog.local","password":"fourth-long-password"}]'
# Privileged/service-role/database credentials must never use NEXT_PUBLIC_ names.
