{
  "name": "nognog-enterprises",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "test:mobile": "tsx --test packages/domain/src/mobile.test.ts src/lib/mobile/http.test.ts src/lib/mobile/compatibility.test.ts",
    "test:mobile-http": "node scripts/test-mobile-http.mjs",
    "test:mobile-integration": "node scripts/test-mobile-integration.mjs",
    "test:all": "tsx --test packages/domain/src/*.test.ts src/lib/**/*.test.ts src/components/ui/*.test.ts",
    "test:migrations": "node scripts/check-migration-versions.mjs",
    "test:erp-gaps": "tsx --test packages/domain/src/attendance.test.ts src/lib/data/pagination.test.ts",
    "test:automatic-attendance": "node scripts/test-automatic-attendance.mjs",
    "test:inventory-pagination": "node scripts/test-inventory-pagination.mjs",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test:unit": "tsx --test src/lib/export/csv.test.ts src/lib/locations/catalog.test.ts packages/domain/src/common.test.ts packages/domain/src/project.test.ts",
    "test:auth": "tsx --test src/lib/users/access.test.ts",
    "test:media": "tsx --test src/lib/media/webp.test.ts src/lib/media/verify-record-photo.test.ts",
    "test:security": "tsx --test src/lib/data/search.test.ts",
    "test:navigation": "tsx --test src/lib/realtime/navigation-cache.test.ts",
    "test:list-views": "tsx --test src/components/ui/record-list-view.test.ts",
    "supabase:start": "npx supabase start",
    "supabase:stop": "npx supabase stop",
    "supabase:reset": "npx supabase db reset",
    "test:inventory-concurrency": "node scripts/test-inventory-concurrency.mjs",
    "test:material-reservations": "node scripts/test-material-reservations.mjs",
    "test:requests": "tsx --test packages/domain/src/material-requests.test.ts",
    "test:daily-reports": "tsx --test packages/domain/src/daily-reports.test.ts",
    "test:inventory-domain": "tsx --test packages/domain/src/inventory-valuation.test.ts",
    "test:batch-costing": "node scripts/test-batch-costing.mjs",
    "test:warehouse-receipts": "node scripts/test-warehouse-receipts.mjs",
    "test:erp-workflow": "node scripts/test-erp-workflow.mjs",
    "test:simple-setup-upgrade": "node scripts/test-simple-setup-upgrade.mjs"
  },
  "dependencies": {
    "@hugeicons/core-free-icons": "^4.3.5",
    "@hugeicons/react": "^1.1.10",
    "@nognog/domain": "^0.1.0",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-slot": "^1.3.3",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.116.0",
    "@zxing/browser": "^0.2.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "next": "16.3.5",
    "pdf-lib": "^1.17.1",
    "qrcode": "^1.5.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sharp": "^0.35.4",
    "tailwind-merge": "^3.7.0",
    "write-excel-file": "^4.1.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.3.16",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
}
